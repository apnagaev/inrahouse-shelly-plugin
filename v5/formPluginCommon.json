{
  "grid": [
    {
      "id": "connection",
      "xs": 12,
      "class": "main",
      "table": "units"
    }
  ],
  "spacing": 10,
  "connection": [
    {
      "prop": "protocol",
      "title": "Режим (http, mqtt или hybrid)",
      "type": "input",
      "default": "http"
    },
    {
      "prop": "host",
      "title": "IP или имя Shelly (можно с портом)",
      "type": "input",
      "default": ""
    },
    {
      "prop": "pollSeconds",
      "title": "Опрос, секунд (1–300)",
      "type": "input",
      "default": 5
    },
    {
      "prop": "timeout",
      "title": "Тайм-аут запроса, мс (250–15000)",
      "type": "input",
      "default": 2500
    },
    {
      "prop": "username",
      "title": "Логин HTTP (если включена защита)",
      "type": "input",
      "default": ""
    },
    {
      "prop": "password",
      "title": "Пароль HTTP",
      "type": "password",
      "default": ""
    },
    {
      "prop": "mqttBroker",
      "title": "URL MQTT-брокера (mqtt:// или mqtts://)",
      "type": "input",
      "default": ""
    },
    {
      "prop": "mqttTopic",
      "title": "Базовый топик MQTT (shellies/имя-устройства)",
      "type": "input",
      "default": ""
    },
    {
      "prop": "mqttUsername",
      "title": "Логин MQTT",
      "type": "input",
      "default": ""
    },
    {
      "prop": "mqttPassword",
      "title": "Пароль MQTT",
      "type": "password",
      "default": ""
    }
  ]
}
